{
  "name": "genset-configurator-ts",
  "version": "1.0.0",
  "description": "Marine generator set configurator in TypeScript, HTML and CSS.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
